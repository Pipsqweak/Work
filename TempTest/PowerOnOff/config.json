                "startupScript": "path_to_startup.ps1",
                "shutdownScript": "path_to_shutdown.ps1"
            },
            {
                "typeName": "VM",
                "startupScript": "path_to_startup.ps1",
                "shutdownScript": "path_to_shutdown.ps1"
            },
            {
                "typeName": "YOUR_CUSTOM_TYPE_HERE",
                "startupScript": "path_to\StartStop_Skeleton.ps1",
                "shutdownScript": "StartStop_Skeleton.ps1"
            }
        ],
